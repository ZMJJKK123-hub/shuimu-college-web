{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noEmitOnError": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "assets/js/**/*.ts",
    "index/assets/**/*.ts",
    "user/assets/**/*.ts",
    "administrator/assets/**/*.ts",
    "admin/assets/**/*.ts",
    "profile/assets/**/*.ts"
  ]
}
