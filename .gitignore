# 操作系统杂项
Thumbs.db
desktop.ini
.DS_Store
~$*

# 编辑器 / IDE
.vscode/
.idea/
*.swp

# AI 助手工作缓存（会话计划等本机产物，不入库）
.zcode/

# 日志与临时文件
*.log
*.tmp

# 内网穿透工具与一键脚本（本机专用，不入库）
cloudflared*.exe
start-tunnel.ps1

# 后端（server/，阶段1起）：依赖与构建产物
node_modules/
dist/
coverage/

# 前端 TS 编译产物（源码 .ts 入库；.js 由 tsc 本地原位编译生成，不入库。
# 注意：site/index/data/banners.js 是数据文件不是编译产物，正常入库，不受影响）
site/assets/js/**/*.js
site/index/assets/*.js
site/user/assets/*.js
site/administrator/assets/*.js
site/admin/assets/*.js
site/profile/assets/*.js

# 后端敏感配置与本地数据（只存服务器，绝不入库）
.env
.env.*
*.sqlite
*.sqlite-journal
*.db

# 账号运行时数据（密码哈希与会话令牌，服务端自动创建，绝不入库）
user_data/
administrator_data/
